{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash scripts/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Write(*.md)",
      "Edit(*.md)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Write(outputs/**)",
      "Edit(outputs/**)",
      "Write(samples/**)",
      "Edit(samples/**)",
      "Write(scripts/**)",
      "Bash(python scripts/**)",
      "Bash(bash scripts/**)",
      "Bash(npm run:*)",
      "Bash(npx cdk:*)",
      "Bash(cdk synth:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f outputs/80_PM/01_スケジュール/project_state.yaml ]; then echo '=== プロジェクト状態 ==='; cat 'outputs/80_PM/01_スケジュール/project_state.yaml'; echo '=== QA/課題 ==='; echo \"オープンQA: $(grep -c '未回答' 'outputs/80_PM/02_課題QA管理/QA_LOG.md' 2>/dev/null || echo 0) 件\"; echo \"オープン課題: $(grep -c 'オープン\\|未対応' 'outputs/80_PM/02_課題QA管理/ISSUE_LOG.md' 2>/dev/null || echo 0) 件\"; else echo '[初回セッション: project_state.yaml 未作成]'; fi"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "infra-network|infra-security|infra-monitoring|infra-iac|infra-gc-environment|infra-backup-dr|infra-cost",
        "hooks": [
          {
            "type": "command",
            "command": "echo '設計エージェント完了。@infra-gap-detector で抜け漏れチェックを推奨します。'"
          }
        ]
      },
      {
        "matcher": "hearing-agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== QA_LOG 更新完了 ===' && grep -c '未回答' 'outputs/80_PM/02_課題QA管理/QA_LOG.md' 2>/dev/null | xargs -I{} echo 'オープンQA: {} 件'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/iac-validate.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
