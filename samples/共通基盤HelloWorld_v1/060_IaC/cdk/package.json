{
  "name": "helloworld-archcmp-cdk",
  "version": "1.0.0",
  "description": "HelloWorld Architecture Comparison CDK App (PARAM-001 ~ PARAM-007)",
  "main": "bin/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dev": "cdk deploy --all -c environment=dev --require-approval never",
    "deploy:stg": "cdk deploy --all -c environment=stg",
    "deploy:prod": "cdk deploy --all -c environment=prod",
    "deploy:pattern": "cdk deploy --all -c environment=dev -c pattern=A"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "aws-cdk": "^2.133.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.133.0",
    "cdk-nag": "^2.28.82",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testMatch": ["**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
